# =====================================================================
#  OtoRent Backend — PRODUCTION env (.env.prod)
#
#  Nạp bởi docker-compose.prod.yml qua `env_file`. KHÔNG commit file này.
#  Các biến DATABASE_URL / REDIS_URL / NODE_ENV / PORT bị compose GHI ĐÈ
#  (trỏ vào MySQL/Redis nội bộ theo tên service), nên để trống ở đây cũng được.
#
#  ⚠️ Secret bên dưới đã được sinh ngẫu nhiên sẵn cho bạn. Có thể dùng luôn,
#     hoặc tự sinh lại. TUYỆT ĐỐI không chia sẻ / không đẩy lên git.
# =====================================================================

# ---- Server ----------------------------------------------------------
NODE_ENV=production
PORT=4000
API_PREFIX=/api/v1
# Domain thật (đổi nếu khác). Dùng cho link trong email + CORS.
APP_URL=https://cargogo.vn
FRONTEND_URL=https://cargogo.vn
CORS_ORIGIN=https://cargogo.vn

# ---- JWT (BẮT BUỘC ≥32 ký tự, không bắt đầu bằng "dev_") -------------
JWT_ACCESS_SECRET=ApzZxNyBofmqj75CKr8boddnXUJjkfb60Zyc1_J3SVpe5YItMNvRBDMquhCXIjHb
JWT_REFRESH_SECRET=OWei2DLFzVqbWhVM4vTWDeFL4b4Ty6exsyr2nCblIiXUpImQUx31r12_wJirWG9m
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ---- Bcrypt / OTP ----------------------------------------------------
BCRYPT_SALT_ROUNDS=12
OTP_LENGTH=6
OTP_TTL_SECONDS=300

# ---- SePay webhook (BẮT BUỘC ở prod, nếu trống server sẽ không khởi động) ----
SEPAY_WEBHOOK_SECRET=tO-Ilsq-CYVnhyjyAK-ufYlxO26TkuW5gW8U7vTfeJY

# ---- SMS OTP — eSMS.vn ----------------------------------------------
# SMS_PROVIDER: mock (chỉ log) | esms | twilio. Prod dùng esms.
SMS_PROVIDER=esms
ESMS_API_KEY=A42C80A74EE9B1CD013DDC9152C371
ESMS_SECRET_KEY=2110C8F1254060CD56F050554936C7
# ⚠️ Đổi thành brandname ĐÃ ĐƯỢC eSMS DUYỆT (xem report B3). Nếu dùng brandname
#    cũ của doanh nghiệp trước, điền đúng tên đó — sai sẽ lỗi CodeResult=104.
ESMS_BRANDNAME=OtoRent
# true = eSMS sandbox (không gửi thật, phải dùng đúng nội dung mẫu của eSMS).
ESMS_SANDBOX=false

# ---- Email SMTP (khuyến nghị có, làm fallback OTP cho khách có email) ----
# Để trống MAIL_HOST => email chỉ log ra console (không gửi thật).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=jaygray20033@gmail.com
MAIL_PASS=mzmywsisjmccabgf
MAIL_FROM_NAME=OtoRent Support
MAIL_FROM=OtoRent Support <jaygray20033@gmail.com>

# ---- Payments — VNPay (điền creds THẬT khi có hợp đồng merchant) -----
VNPAY_TMN_CODE=DKRKZ7PR
VNPAY_HASH_SECRET=HV0OBUI5SZB6FOLVZ6D5L2X7DNV186U5
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
