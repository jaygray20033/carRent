// ─────────────────────────────────────────────────────────────────────
//  OtoRent — Prisma Schema
//  Provider: MySQL (Docker)
// ─────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Roles ──────────────────────────────────────────────────────────
model Role {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  users       User[]

  @@map("roles")
}

// ─── Users ──────────────────────────────────────────────────────────
model User {
  id               Int       @id @default(autoincrement())
  roleId           Int       @map("role_id")
  fullName         String    @map("full_name")
  email            String?   @unique
  phone            String    @unique
  countryCode      String    @default("+84") @map("country_code")
  passwordHash     String    @map("password_hash")
  avatarUrl        String?   @map("avatar_url")
  dateOfBirth      DateTime? @map("date_of_birth")
  gender           String?
  nationalId       String?   @map("national_id")
  driverLicense    String?   @map("driver_license")
  status           String    @default("PENDING")
  emailVerifiedAt  DateTime? @map("email_verified_at")
  phoneVerifiedAt  DateTime? @map("phone_verified_at")
  lastLoginAt      DateTime? @map("last_login_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  role               Role                @relation(fields: [roleId], references: [id])
  bookings           Booking[]
  wallet             Wallet?
  walletTransactions WalletTransaction[]
  payments           Payment[]
  posts              Post[]
  refreshTokens      RefreshToken[]

  @@map("users")
}

// ─── Refresh Tokens (JWT rotation — UC-02/04) ──────────────────────
model RefreshToken {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  tokenHash  String    @map("token_hash") @db.VarChar(128)
  deviceInfo String?   @map("device_info") @db.VarChar(512)
  ipAddress  String?   @map("ip_address") @db.VarChar(45)
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// ─── Brands ─────────────────────────────────────────────────────────
model Brand {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  slug      String    @unique
  logoUrl   String?   @map("logo_url")
  country   String?
  createdAt DateTime  @default(now()) @map("created_at")

  vehicles      Vehicle[]
  vehicleModels VehicleModel[]

  @@map("brands")
}

// ─── Vehicle Models ─────────────────────────────────────────────────
model VehicleModel {
  id           Int       @id @default(autoincrement())
  brandId      Int       @map("brand_id")
  categoryId   Int?      @map("category_id")
  name         String
  slug         String    @unique
  seats        Int       @default(5)
  transmission String    @default("AUTO")
  fuelType     String    @default("GASOLINE") @map("fuel_type")
  description  String?   @db.Text
  createdAt    DateTime  @default(now()) @map("created_at")

  brand    Brand     @relation(fields: [brandId], references: [id])
  category Category? @relation(fields: [categoryId], references: [id])
  vehicles Vehicle[]

  @@map("vehicle_models")
}

// ─── Categories ─────────────────────────────────────────────────────
model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  slug      String    @unique
  icon      String?
  createdAt DateTime  @default(now()) @map("created_at")

  vehicles      Vehicle[]
  vehicleModels VehicleModel[]

  @@map("categories")
}

// ─── Stations ───────────────────────────────────────────────────────
model Station {
  id        Int      @id @default(autoincrement())
  name      String
  type      String   @default("CITY")
  city      String
  district  String?
  address   String
  latitude  Float?
  longitude Float?
  phone     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  vehicles         Vehicle[]
  pickupBookings   Booking[] @relation("pickupStation")
  dropoffBookings  Booking[] @relation("dropoffStation")

  @@map("stations")
}

// ─── Vehicles ───────────────────────────────────────────────────────
model Vehicle {
  id            Int      @id @default(autoincrement())
  brandId       Int      @map("brand_id")
  modelId       Int?     @map("model_id")
  categoryId    Int?     @map("category_id")
  stationId     Int?     @map("station_id")
  name          String
  slug          String   @unique
  modelYear     Int      @map("model_year")
  licensePlate  String   @unique @map("license_plate")
  color         String?
  seats         Int      @default(5)
  transmission  String   @default("AUTO")
  fuelType      String   @default("GASOLINE") @map("fuel_type")
  pricePerDay   Float    @map("price_per_day")
  pricePerMonth Float?   @map("price_per_month")
  depositAmount Float    @default(0) @map("deposit_amount")
  description   String?  @db.Text
  thumbnailUrl  String?  @map("thumbnail_url")
  status        String   @default("AVAILABLE")
  rating        Float    @default(0)
  reviewCount   Int      @default(0) @map("review_count")
  totalBookings Int      @default(0) @map("total_bookings")
  isFeatured    Boolean  @default(false) @map("is_featured")
  featuredTag   String?  @map("featured_tag")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  brand    Brand          @relation(fields: [brandId], references: [id])
  model    VehicleModel?  @relation(fields: [modelId], references: [id])
  category Category?     @relation(fields: [categoryId], references: [id])
  station  Station?      @relation(fields: [stationId], references: [id])
  images   VehicleImage[]
  bookings Booking[]

  @@map("vehicles")
}

// ─── Vehicle Images ─────────────────────────────────────────────────
model VehicleImage {
  id        Int      @id @default(autoincrement())
  vehicleId Int      @map("vehicle_id")
  url       String
  isPrimary Boolean  @default(false) @map("is_primary")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@map("vehicle_images")
}

// ─── Insurance Plans (Day 12 — UC-15) ───────────────────────────────
model InsurancePlan {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  description String?  @db.Text
  ratePercent Float    @map("rate_percent")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  bookings Booking[]

  @@map("insurance_plans")
}

// ─── Coupons (Day 12 — UC-16) ──────────────────────────────────────
model Coupon {
  id              Int       @id @default(autoincrement())
  code            String    @unique
  type            String    // FIXED, PERCENT, FREE_DRIVER
  value           Float
  minOrder        Float     @default(0) @map("min_order")
  maxDiscount     Float?    @map("max_discount")
  maxUse          Int       @default(0) @map("max_use")
  maxUsePerUser   Int       @default(1) @map("max_use_per_user")
  startAt         DateTime  @map("start_at")
  endAt           DateTime  @map("end_at")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")

  usages CouponUsage[]

  @@map("coupons")
}

// ─── Coupon Usages ──────────────────────────────────────────────────
model CouponUsage {
  id        Int      @id @default(autoincrement())
  couponId  Int      @map("coupon_id")
  userId    Int      @map("user_id")
  bookingId Int      @map("booking_id")
  discount  Float
  createdAt DateTime @default(now()) @map("created_at")

  coupon Coupon @relation(fields: [couponId], references: [id])

  @@map("coupon_usages")
}

// ─── Bookings ───────────────────────────────────────────────────────
model Booking {
  id               Int       @id @default(autoincrement())
  bookingCode      String    @unique @map("booking_code")
  userId           Int       @map("user_id")
  vehicleId        Int       @map("vehicle_id")
  pickupStationId  Int?      @map("pickup_station_id")
  dropoffStationId Int?      @map("dropoff_station_id")
  insurancePlanId  Int?      @map("insurance_plan_id")
  couponId         Int?      @map("coupon_id")
  rentalType       String    @default("SELF_DRIVE") @map("rental_type")
  pickupAt         DateTime  @map("pickup_at")
  returnAt         DateTime  @map("return_at")
  pickupPoint      String?   @map("pickup_point")
  dropoffPoint     String?   @map("dropoff_point")
  totalDays        Int       @map("total_days")
  pricePerDay      Float     @map("price_per_day")
  subtotal         Float     @default(0)
  insuranceFee     Float     @default(0) @map("insurance_fee")
  couponDiscount   Float     @default(0) @map("coupon_discount")
  totalAmount      Float     @map("total_amount")
  status           String    @default("DRAFT")
  holdUntil        DateTime? @map("hold_until")
  cancelReason     String?   @map("cancel_reason") @db.Text
  cancelledAt      DateTime? @map("cancelled_at")
  refundAmount     Float     @default(0) @map("refund_amount")
  refundPercent    Int       @default(0) @map("refund_percent")
  refundStatus     String?   @map("refund_status") // null | PENDING | PROCESSING | REFUNDED | FAILED | NONE
  note             String?   @db.Text
  pricingSnapshot  String?   @map("pricing_snapshot") @db.Text
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user           User           @relation(fields: [userId], references: [id])
  vehicle        Vehicle        @relation(fields: [vehicleId], references: [id])
  pickupStation  Station?       @relation("pickupStation", fields: [pickupStationId], references: [id])
  dropoffStation Station?       @relation("dropoffStation", fields: [dropoffStationId], references: [id])
  insurancePlan  InsurancePlan? @relation(fields: [insurancePlanId], references: [id])
  history        BookingHistory[]
  payments       Payment[]

  @@map("bookings")
}

// ─── Booking History ────────────────────────────────────────────────
model BookingHistory {
  id         Int      @id @default(autoincrement())
  bookingId  Int      @map("booking_id")
  fromStatus String?  @map("from_status")
  toStatus   String   @map("to_status")
  changedBy  Int?     @map("changed_by")
  note       String?  @db.Text
  metadata   String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("booking_histories")
}

// ─── Payments ───────────────────────────────────────────────────────
model Payment {
  id            Int       @id @default(autoincrement())
  bookingId     Int?      @map("booking_id")
  userId        Int?      @map("user_id")
  type          String    @default("BOOKING") // BOOKING, TOPUP
  method        String    // VNPAY, MOMO, ZALOPAY, WALLET, BANK_TRANSFER, CASH
  amount        Float
  status        String    @default("PENDING") // PENDING, SUCCESS, FAILED, REFUNDED
  txnRef        String?   @unique @map("txn_ref") // UUID handed to the provider; basis for webhook idempotency
  transactionId String?   @map("transaction_id")
  paidAt        DateTime? @map("paid_at")
  metadata      String?   @db.Text
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  booking Booking? @relation(fields: [bookingId], references: [id])
  user    User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("payments")
}

// ─── Reviews ────────────────────────────────────────────────────────
model Review {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  vehicleId Int      @map("vehicle_id")
  rating    Int
  comment   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@map("reviews")
}

// ─── Posts ──────────────────────────────────────────────────────────
model Post {
  id           Int       @id @default(autoincrement())
  authorId     Int?      @map("author_id")
  categoryId   Int?      @map("category_id")
  title        String
  slug         String    @unique
  excerpt      String?   @db.Text
  content      String    @db.LongText
  thumbnailUrl String?   @map("thumbnail_url")
  status       String    @default("PUBLISHED")
  isFeatured   Boolean   @default(false) @map("is_featured")
  viewCount    Int       @default(0) @map("view_count")
  publishedAt  DateTime? @map("published_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  author   User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  category PostCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags     PostTag[]

  @@index([status, publishedAt])
  @@index([categoryId])
  @@map("posts")
}

// ─── Post Categories ────────────────────────────────────────────────
model PostCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  posts Post[]

  @@map("post_categories")
}

// ─── Tags ───────────────────────────────────────────────────────────
model Tag {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  posts PostTag[]

  @@map("tags")
}

// ─── Post ↔ Tag (many-to-many) ──────────────────────────────────────
model PostTag {
  postId Int @map("post_id")
  tagId  Int @map("tag_id")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
  @@map("post_tags")
}

// ─── Wallets ────────────────────────────────────────────────────────
model Wallet {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique @map("user_id")
  balance   Float    @default(0)
  currency  String   @default("VND")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

// ─── Wallet Transactions (Day 16 — UC-44, UC-45, UC-46) ─────────────
model WalletTransaction {
  id            Int      @id @default(autoincrement())
  walletId      Int      @map("wallet_id")
  userId        Int      @map("user_id")
  type          String   // TOPUP, PAYMENT, REFUND, WITHDRAW
  amount        Float    // dương = cộng tiền, âm = trừ tiền
  balanceBefore Float    @map("balance_before")
  balanceAfter  Float    @map("balance_after")
  status        String   @default("SUCCESS") // PENDING, SUCCESS, FAILED
  referenceType String?  @map("reference_type") // PAYMENT, BOOKING, ...
  referenceId   Int?     @map("reference_id")
  description   String?  @db.Text
  metadata      String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([userId])
  @@index([type])
  @@map("wallet_transactions")
}

// ─── Site Settings ──────────────────────────────────────────────────
model SiteSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String?  @db.Text
  grp       String?
  label     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}
