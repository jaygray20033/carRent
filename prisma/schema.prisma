// Prisma schema for CarRent
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------- ENUMS ----------------
enum UserStatus {
  ACTIVE
  LOCKED
  PENDING
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum CarStatus {
  AVAILABLE
  RENTED
  MAINTENANCE
  RETIRED
}

enum Transmission {
  AUTO
  MANUAL
}

enum FuelType {
  GASOLINE
  DIESEL
  HYBRID
  ELECTRIC
}

enum RentalType {
  SELF_DRIVE
  WITH_DRIVER
}

enum BookingStatus {
  DRAFT
  PENDING_PAYMENT
  CONFIRMED
  IN_USE
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  VNPAY
  MOMO
  ZALOPAY
  WALLET
  BANK_TRANSFER
  CASH
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

// ---------------- MODELS ----------------
model Role {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(32) // CUSTOMER, ADMIN, OPERATOR, AGENT
  name        String   @db.VarChar(100)
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  users User[]

  @@map("roles")
}

model User {
  id              BigInt     @id @default(autoincrement())
  roleId          Int        @map("role_id")
  fullName        String     @map("full_name") @db.VarChar(150)
  email           String?    @unique @db.VarChar(160)
  phone           String     @unique @db.VarChar(20)
  countryCode     String     @default("+84") @map("country_code") @db.VarChar(8)
  passwordHash    String     @map("password_hash") @db.VarChar(255)
  avatarUrl       String?    @map("avatar_url")
  dateOfBirth     DateTime?  @map("date_of_birth") @db.Date
  gender          Gender?
  nationalId      String?    @map("national_id") @db.VarChar(50)
  driverLicense   String?    @map("driver_license") @db.VarChar(50)
  status          UserStatus @default(PENDING)
  emailVerifiedAt DateTime?  @map("email_verified_at")
  phoneVerifiedAt DateTime?  @map("phone_verified_at")
  lastLoginAt     DateTime?  @map("last_login_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  role          Role           @relation(fields: [roleId], references: [id])
  bookings      Booking[]
  refreshTokens RefreshToken[]

  @@index([phone])
  @@index([email])
  @@index([status])
  @@map("users")
}

model RefreshToken {
  id         BigInt    @id @default(autoincrement())
  userId     BigInt    @map("user_id")
  tokenHash  String    @map("token_hash") @db.VarChar(255)
  deviceInfo String?   @map("device_info") @db.VarChar(255)
  ipAddress  String?   @map("ip_address") @db.VarChar(50)
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model CarBrand {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  logoUrl   String?  @map("logo_url")
  createdAt DateTime @default(now()) @map("created_at")

  cars Car[]

  @@map("car_brands")
}

model CarCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100) // Sedan, SUV, MPV, Hatchback, Pickup, Coupe
  slug      String   @unique @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at")

  cars Car[]

  @@map("car_categories")
}

model Station {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(150)
  city      String   @db.VarChar(100)
  district  String?  @db.VarChar(100)
  address   String
  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)
  phone     String?  @db.VarChar(20)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  cars             Car[]
  pickupBookings   Booking[] @relation("PickupStation")
  dropoffBookings  Booking[] @relation("DropoffStation")

  @@index([city])
  @@map("stations")
}

model Car {
  id              BigInt       @id @default(autoincrement())
  brandId         Int          @map("brand_id")
  categoryId      Int          @map("category_id")
  stationId       Int?         @map("station_id")
  name            String       @db.VarChar(200)
  slug            String       @unique @db.VarChar(220)
  modelYear       Int          @map("model_year")
  licensePlate    String       @unique @map("license_plate") @db.VarChar(20)
  color           String?      @db.VarChar(50)
  seats           Int          @default(5)
  transmission    Transmission @default(AUTO)
  fuelType        FuelType     @default(GASOLINE)
  pricePerDay     Decimal      @map("price_per_day") @db.Decimal(12, 2)
  description     String?
  thumbnailUrl    String?      @map("thumbnail_url")
  status          CarStatus    @default(AVAILABLE)
  rating          Decimal      @default(0) @db.Decimal(3, 2)
  totalBookings   Int          @default(0) @map("total_bookings")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  brand    CarBrand    @relation(fields: [brandId], references: [id])
  category CarCategory @relation(fields: [categoryId], references: [id])
  station  Station?    @relation(fields: [stationId], references: [id])
  images   CarImage[]
  bookings Booking[]

  @@index([brandId])
  @@index([categoryId])
  @@index([status])
  @@index([pricePerDay])
  @@map("cars")
}

model CarImage {
  id        BigInt   @id @default(autoincrement())
  carId     BigInt   @map("car_id")
  url       String
  isPrimary Boolean  @default(false) @map("is_primary")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  car Car @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@index([carId])
  @@map("car_images")
}

model Booking {
  id                BigInt        @id @default(autoincrement())
  bookingCode       String        @unique @map("booking_code") @db.VarChar(30)
  userId            BigInt        @map("user_id")
  carId             BigInt        @map("car_id")
  pickupStationId   Int?          @map("pickup_station_id")
  dropoffStationId  Int?          @map("dropoff_station_id")
  rentalType        RentalType    @default(SELF_DRIVE) @map("rental_type")
  pickupAt          DateTime      @map("pickup_at")
  returnAt          DateTime      @map("return_at")
  totalDays         Int           @map("total_days")
  pricePerDay       Decimal       @map("price_per_day") @db.Decimal(12, 2)
  subtotal          Decimal       @db.Decimal(12, 2)
  insuranceFee      Decimal       @default(0) @map("insurance_fee") @db.Decimal(12, 2)
  discount          Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount       Decimal       @map("total_amount") @db.Decimal(12, 2)
  status            BookingStatus @default(PENDING_PAYMENT)
  note              String?
  cancelReason      String?       @map("cancel_reason")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  user            User      @relation(fields: [userId], references: [id])
  car             Car       @relation(fields: [carId], references: [id])
  pickupStation   Station?  @relation("PickupStation", fields: [pickupStationId], references: [id])
  dropoffStation  Station?  @relation("DropoffStation", fields: [dropoffStationId], references: [id])
  payments        Payment[]

  @@index([userId])
  @@index([carId])
  @@index([status])
  @@index([pickupAt, returnAt])
  @@map("bookings")
}

model Payment {
  id            BigInt        @id @default(autoincrement())
  bookingId     BigInt        @map("booking_id")
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  transactionId String?       @map("transaction_id") @db.VarChar(100)
  paidAt        DateTime?     @map("paid_at")
  rawResponse   Json?         @map("raw_response")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([status])
  @@map("payments")
}
