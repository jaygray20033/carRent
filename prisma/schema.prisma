// ─────────────────────────────────────────────────────────────────────
//  CarGoGo — Prisma Schema
//  Provider: MySQL (Docker)
// ─────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Roles ──────────────────────────────────────────────────────────
model Role {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  users       User[]

  @@map("roles")
}

// ─── Users ──────────────────────────────────────────────────────────
model User {
  id              Int       @id @default(autoincrement())
  roleId          Int       @map("role_id")
  fullName        String    @map("full_name")
  email           String?   @unique
  phone           String    @unique
  countryCode     String    @default("+84") @map("country_code")
  passwordHash    String    @map("password_hash")
  avatarUrl       String?   @map("avatar_url")
  dateOfBirth     DateTime? @map("date_of_birth")
  gender          String?
  nationalId      String?   @map("national_id")
  driverLicense   String?   @map("driver_license")
  status          String    @default("PENDING")
  emailVerifiedAt DateTime? @map("email_verified_at")
  phoneVerifiedAt DateTime? @map("phone_verified_at")
  lastLoginAt     DateTime? @map("last_login_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  role                 Role                  @relation(fields: [roleId], references: [id])
  bookings             Booking[]             @relation("bookingRenter")
  assignedBookings     Booking[]             @relation("bookingAssignee")
  wallet               Wallet?
  walletTransactions   WalletTransaction[]
  payments             Payment[]
  posts                Post[]
  refreshTokens        RefreshToken[]
  comments             Comment[]
  notifications        Notification[]
  addresses            Address[]
  agentApplications    AgentApplication[]
  sosRequests          SosRequest[]
  corporateEmployee    CorporateEmployee?
  supplierMember       SupplierMember?
  supplierApplications SupplierApplication[]

  @@map("users")
}

// ─── Refresh Tokens (JWT rotation — UC-02/04) ──────────────────────
model RefreshToken {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  tokenHash  String    @map("token_hash") @db.VarChar(128)
  deviceInfo String?   @map("device_info") @db.VarChar(512)
  ipAddress  String?   @map("ip_address") @db.VarChar(45)
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// ─── Brands ─────────────────────────────────────────────────────────
model Brand {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  logoUrl   String?  @map("logo_url")
  country   String?
  createdAt DateTime @default(now()) @map("created_at")

  vehicles      Vehicle[]
  vehicleModels VehicleModel[]

  @@map("brands")
}

// ─── Vehicle Models ─────────────────────────────────────────────────
model VehicleModel {
  id           Int      @id @default(autoincrement())
  brandId      Int      @map("brand_id")
  categoryId   Int?     @map("category_id")
  name         String
  slug         String   @unique
  seats        Int      @default(5)
  transmission String   @default("AUTO")
  fuelType     String   @default("GASOLINE") @map("fuel_type")
  description  String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  brand    Brand     @relation(fields: [brandId], references: [id])
  category Category? @relation(fields: [categoryId], references: [id])
  vehicles Vehicle[]

  @@map("vehicle_models")
}

// ─── Categories ─────────────────────────────────────────────────────
model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  icon      String?
  createdAt DateTime @default(now()) @map("created_at")

  vehicles      Vehicle[]
  vehicleModels VehicleModel[]

  @@map("categories")
}

// ─── Stations ───────────────────────────────────────────────────────
model Station {
  id        Int      @id @default(autoincrement())
  name      String
  type      String   @default("CITY")
  city      String
  district  String?
  address   String
  latitude  Float?
  longitude Float?
  phone     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  vehicles        Vehicle[]
  pickupBookings  Booking[] @relation("pickupStation")
  dropoffBookings Booking[] @relation("dropoffStation")

  @@map("stations")
}

// ─── Vehicles ───────────────────────────────────────────────────────
model Vehicle {
  id            Int      @id @default(autoincrement())
  brandId       Int      @map("brand_id")
  modelId       Int?     @map("model_id")
  categoryId    Int?     @map("category_id")
  stationId     Int?     @map("station_id")
  name          String
  slug          String   @unique
  modelYear     Int      @map("model_year")
  licensePlate  String   @unique @map("license_plate")
  color         String?
  seats         Int      @default(5)
  transmission  String   @default("AUTO")
  fuelType      String   @default("GASOLINE") @map("fuel_type")
  pricePerDay   Float    @map("price_per_day")
  pricePerMonth Float?   @map("price_per_month")
  depositAmount Float    @default(0) @map("deposit_amount")
  description   String?  @db.Text
  thumbnailUrl  String?  @map("thumbnail_url")
  status        String   @default("AVAILABLE")
  rating        Float    @default(0)
  reviewCount   Int      @default(0) @map("review_count")
  totalBookings Int      @default(0) @map("total_bookings")
  isFeatured    Boolean  @default(false) @map("is_featured")
  featuredTag   String?  @map("featured_tag")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  brand             Brand              @relation(fields: [brandId], references: [id])
  model             VehicleModel?      @relation(fields: [modelId], references: [id])
  category          Category?          @relation(fields: [categoryId], references: [id])
  station           Station?           @relation(fields: [stationId], references: [id])
  images            VehicleImage[]
  bookings          Booking[]
  corporateBookings CorporateBooking[]

  @@map("vehicles")
}

// ─── Vehicle Images ─────────────────────────────────────────────────
model VehicleImage {
  id        Int      @id @default(autoincrement())
  vehicleId Int      @map("vehicle_id")
  url       String
  isPrimary Boolean  @default(false) @map("is_primary")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@map("vehicle_images")
}

// ─── Insurance Plans (Day 12 — UC-15) ───────────────────────────────
model InsurancePlan {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  description String?  @db.Text
  ratePercent Float    @map("rate_percent")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  bookings Booking[]

  @@map("insurance_plans")
}

// ─── Coupons (Day 12 — UC-16) ──────────────────────────────────────
model Coupon {
  id            Int      @id @default(autoincrement())
  code          String   @unique
  type          String // FIXED, PERCENT, FREE_DRIVER
  value         Float
  minOrder      Float    @default(0) @map("min_order")
  maxDiscount   Float?   @map("max_discount")
  maxUse        Int      @default(0) @map("max_use")
  maxUsePerUser Int      @default(1) @map("max_use_per_user")
  startAt       DateTime @map("start_at")
  endAt         DateTime @map("end_at")
  appliesTo     String   @default("ALL") @map("applies_to") // ALL, CATEGORY, MODEL
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  usages CouponUsage[]

  @@map("coupons")
}

// ─── Coupon Usages ──────────────────────────────────────────────────
model CouponUsage {
  id        Int      @id @default(autoincrement())
  couponId  Int      @map("coupon_id")
  userId    Int      @map("user_id")
  bookingId Int      @map("booking_id")
  discount  Float
  createdAt DateTime @default(now()) @map("created_at")

  coupon Coupon @relation(fields: [couponId], references: [id])

  @@map("coupon_usages")
}

// ─── Bookings ───────────────────────────────────────────────────────
model Booking {
  id               Int       @id @default(autoincrement())
  bookingCode      String    @unique @map("booking_code")
  userId           Int       @map("user_id")
  vehicleId        Int       @map("vehicle_id")
  pickupStationId  Int?      @map("pickup_station_id")
  dropoffStationId Int?      @map("dropoff_station_id")
  insurancePlanId  Int?      @map("insurance_plan_id")
  couponId         Int?      @map("coupon_id")
  rentalType       String    @default("SELF_DRIVE") @map("rental_type")
  pickupAt         DateTime  @map("pickup_at")
  returnAt         DateTime  @map("return_at")
  pickupPoint      String?   @map("pickup_point")
  dropoffPoint     String?   @map("dropoff_point")
  totalDays        Int       @map("total_days")
  pricePerDay      Float     @map("price_per_day")
  subtotal         Float     @default(0)
  driverFee        Float     @default(0) @map("driver_fee")
  insuranceFee     Float     @default(0) @map("insurance_fee")
  dropoffPenalty   Float     @default(0) @map("dropoff_penalty")
  taxAmount        Float     @default(0) @map("tax_amount")
  depositAmount    Float     @default(0) @map("deposit_amount")
  couponDiscount   Float     @default(0) @map("coupon_discount")
  totalAmount      Float     @map("total_amount")
  status           String    @default("DRAFT")
  holdUntil        DateTime? @map("hold_until")
  cancelReason     String?   @map("cancel_reason") @db.Text
  cancelledAt      DateTime? @map("cancelled_at")
  refundAmount     Float     @default(0) @map("refund_amount")
  refundPercent    Int       @default(0) @map("refund_percent")
  refundStatus     String?   @map("refund_status") // null | PENDING | PROCESSING | REFUNDED | FAILED | NONE
  actualPickupAt   DateTime? @map("actual_pickup_at") // set when handed over (IN_USE)
  actualReturnAt   DateTime? @map("actual_return_at") // set when returned (COMPLETED)
  extraFee         Float     @default(0) @map("extra_fee") // fuel/charge/damage charged at return
  note             String?   @db.Text
  pricingSnapshot  String?   @map("pricing_snapshot") @db.Text
  assignedStaffId  Int?      @map("assigned_staff_id") // staff (ADMIN/OPERATOR/AGENT) tasked with handover
  assignedAt       DateTime? @map("assigned_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user              User             @relation("bookingRenter", fields: [userId], references: [id])
  assignedStaff     User?            @relation("bookingAssignee", fields: [assignedStaffId], references: [id])
  vehicle           Vehicle          @relation(fields: [vehicleId], references: [id])
  pickupStation     Station?         @relation("pickupStation", fields: [pickupStationId], references: [id])
  dropoffStation    Station?         @relation("dropoffStation", fields: [dropoffStationId], references: [id])
  insurancePlan     InsurancePlan?   @relation(fields: [insurancePlanId], references: [id])
  history           BookingHistory[]
  payments          Payment[]
  sosRequests       SosRequest[]     @relation("bookingSos")
  sosReplacementFor SosRequest[]     @relation("replacementBooking")

  // Overlap/availability check (car.service, booking.service) filters by
  // vehicle then the pickup/return window — covers UC-14 conflict detection.
  @@index([vehicleId, pickupAt, returnAt])
  // "My bookings" list is filtered by user + status.
  @@index([userId, status])
  @@map("bookings")
}

// ─── Booking History ────────────────────────────────────────────────
model BookingHistory {
  id         Int      @id @default(autoincrement())
  bookingId  Int      @map("booking_id")
  fromStatus String?  @map("from_status")
  toStatus   String   @map("to_status")
  changedBy  Int?     @map("changed_by")
  note       String?  @db.Text
  metadata   String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("booking_histories")
}

// ─── Payments ───────────────────────────────────────────────────────
model Payment {
  id            Int       @id @default(autoincrement())
  bookingId     Int?      @map("booking_id")
  userId        Int?      @map("user_id")
  type          String    @default("BOOKING") // BOOKING, TOPUP
  method        String // VNPAY, MOMO, ZALOPAY, WALLET, BANK_TRANSFER, CASH
  amount        Float
  status        String    @default("PENDING") // PENDING, SUCCESS, FAILED, REFUNDED
  txnRef        String?   @unique @map("txn_ref") // UUID handed to the provider; basis for webhook idempotency
  transactionId String?   @map("transaction_id")
  paidAt        DateTime? @map("paid_at")
  metadata      String?   @db.Text
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  booking Booking? @relation(fields: [bookingId], references: [id])
  user    User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  // Payment lookups by booking (refund search, receipt, status polling).
  @@index([bookingId])
  @@map("payments")
}

// ─── Reviews (UC-50) ────────────────────────────────────────────────
model Review {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  vehicleId Int      @map("vehicle_id")
  bookingId Int?     @unique @map("booking_id") // one review per completed booking
  rating    Int // 1-5
  content   String?  @db.Text
  photos    String?  @db.Text // JSON array of image URLs
  status    String   @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt DateTime @default(now()) @map("created_at")

  @@index([vehicleId, status])
  @@index([userId])
  @@map("reviews")
}

// ─── Posts ──────────────────────────────────────────────────────────
model Post {
  id           Int       @id @default(autoincrement())
  authorId     Int?      @map("author_id")
  categoryId   Int?      @map("category_id")
  title        String
  slug         String    @unique
  excerpt      String?   @db.Text
  content      String    @db.LongText
  thumbnailUrl String?   @map("thumbnail_url")
  status       String    @default("PUBLISHED")
  isFeatured   Boolean   @default(false) @map("is_featured")
  viewCount    Int       @default(0) @map("view_count")
  publishedAt  DateTime? @map("published_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  author   User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  category PostCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags     PostTag[]
  comments Comment[]

  @@index([status, publishedAt])
  @@index([categoryId])
  @@map("posts")
}

// ─── Post Categories ────────────────────────────────────────────────
model PostCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  posts Post[]

  @@map("post_categories")
}

// ─── Tags ───────────────────────────────────────────────────────────
model Tag {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  posts PostTag[]

  @@map("tags")
}

// ─── Post ↔ Tag (many-to-many) ──────────────────────────────────────
model PostTag {
  postId Int @map("post_id")
  tagId  Int @map("tag_id")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
  @@map("post_tags")
}

// ─── Wallets ────────────────────────────────────────────────────────
model Wallet {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique @map("user_id")
  balance   Float    @default(0)
  currency  String   @default("VND")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

// ─── Wallet Transactions (Day 16 — UC-44, UC-45, UC-46) ─────────────
model WalletTransaction {
  id            Int      @id @default(autoincrement())
  walletId      Int      @map("wallet_id")
  userId        Int      @map("user_id")
  type          String // TOPUP, PAYMENT, REFUND, WITHDRAW
  amount        Float // dương = cộng tiền, âm = trừ tiền
  balanceBefore Float    @map("balance_before")
  balanceAfter  Float    @map("balance_after")
  status        String   @default("SUCCESS") // PENDING, SUCCESS, FAILED
  referenceType String?  @map("reference_type") // PAYMENT, BOOKING, ...
  referenceId   Int?     @map("reference_id")
  description   String?  @db.Text
  metadata      String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([userId])
  @@index([type])
  @@map("wallet_transactions")
}

// ─── Site Settings ──────────────────────────────────────────────────
model SiteSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String?  @db.Text
  grp       String?
  label     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

// ─── Contact Messages (UC-28/29/30) ─────────────────────────────────
model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String   @db.Text
  status    String   @default("NEW") // NEW | READ | REPLIED
  replyNote String?  @map("reply_note") @db.Text
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("contact_messages")
}

// ─── Roadside / Rescue Stations (UC-31) ─────────────────────────────
model RescueStation {
  id        Int      @id @default(autoincrement())
  name      String
  city      String?
  district  String?
  address   String
  latitude  Float
  longitude Float
  phone     String?
  hours     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sosRequests SosRequest[]

  @@index([isActive])
  @@map("rescue_stations")
}

// ─── Comments (UC-24) ───────────────────────────────────────────────
model Comment {
  id        Int      @id @default(autoincrement())
  postId    Int      @map("post_id")
  userId    Int      @map("user_id")
  content   String   @db.Text
  status    String   @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, status])
  @@index([userId])
  @@index([status])
  @@map("comments")
}

// ─── Notifications (UC-51 placeholder) ──────────────────────────────
model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  type      String // e.g. COMMENT_APPROVED
  title     String
  body      String?  @db.Text
  link      String? // in-app deep link (e.g. /magazine/<slug>)
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

// ─── Address Book (UC-42, UC-43) ────────────────────────────────────
model Address {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  contactName  String   @map("contact_name")
  contactPhone String   @map("contact_phone")
  line         String   @db.Text // street address (số nhà, đường)
  ward         String?
  district     String?
  city         String
  postalCode   String?  @map("postal_code")
  latitude     Float?
  longitude    Float?
  isDefault    Boolean  @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// ─── Agent Applications (Day 38 — UC-32/33) ─────────────────────────
model AgentApplication {
  id                   Int       @id @default(autoincrement())
  userId               Int       @map("user_id")
  applicantType        String    @default("INDIVIDUAL") @map("applicant_type") // INDIVIDUAL | BUSINESS
  businessName         String    @map("business_name")
  taxCode              String?   @map("tax_code") // MST
  address              String    @db.Text
  expectedVehicleCount Int       @default(1) @map("expected_vehicle_count")
  note                 String?   @db.Text
  kycFileUrl           String?   @map("kyc_file_url")
  status               String    @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewedBy           Int?      @map("reviewed_by")
  reviewNote           String?   @map("review_note") @db.Text
  reviewedAt           DateTime? @map("reviewed_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("agent_applications")
}

// ─── SOS Requests (Day 39 — UC-34/35/36) ────────────────────────────
model SosRequest {
  id                   Int       @id @default(autoincrement())
  bookingId            Int       @map("booking_id")
  userId               Int       @map("user_id")
  latitude             Float
  longitude            Float
  issueType            String    @map("issue_type") // FLAT_TIRE | DEAD_BATTERY | ACCIDENT | ENGINE | OUT_OF_FUEL | OTHER
  description          String?   @db.Text
  photos               String?   @db.Text // JSON array of image URLs
  status               String    @default("REQUESTED") // REQUESTED | DISPATCHED | ON_THE_WAY | RESOLVED | CANCELLED
  rescueStationId      Int?      @map("rescue_station_id")
  distanceKm           Float?    @map("distance_km")
  estimatedArrival     DateTime? @map("estimated_arrival")
  driverName           String?   @map("driver_name")
  driverPhone          String?   @map("driver_phone")
  resolutionNote       String?   @map("resolution_note") @db.Text
  replacementBookingId Int?      @map("replacement_booking_id")
  handledBy            Int?      @map("handled_by")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  booking            Booking        @relation("bookingSos", fields: [bookingId], references: [id])
  user               User           @relation(fields: [userId], references: [id])
  rescueStation      RescueStation? @relation(fields: [rescueStationId], references: [id])
  replacementBooking Booking?       @relation("replacementBooking", fields: [replacementBookingId], references: [id])

  @@index([status])
  @@index([userId])
  @@index([bookingId])
  @@map("sos_requests")
}

// ─── B2B: Corporate Clients (UC-61+) ────────────────────────────────
// Default AssetHub price table lives in priceConfig (JSON string).
model CorporateClient {
  id                      Int       @id @default(autoincrement())
  name                    String
  taxCode                 String    @unique @map("tax_code")
  address                 String?   @db.Text
  contactName             String?   @map("contact_name")
  contactPhone            String?   @map("contact_phone")
  contactEmail            String?   @map("contact_email")
  contractRef             String?   @map("contract_ref")
  contractStart           DateTime? @map("contract_start")
  contractEnd             DateTime? @map("contract_end")
  creditLimit             Float     @default(0) @map("credit_limit")
  paymentTermDays         Int       @default(0) @map("payment_term_days")
  // JSON: { "4_5_seat": { half_day_0_100km, ... }, "7_seat": {...}, "16_seat": {...} }
  priceConfig             String?   @map("price_config") @db.Text
  isActive                Boolean   @default(true) @map("is_active")
  // When true, employee bookings skip corporate-admin approval (PENDING→APPROVED
  // on create). Admin toggles this from the corporate portal settings.
  autoApproveBookings     Boolean   @default(false) @map("auto_approve_bookings")
  // ENT-Day 3 — true when confirmed CRITICAL SLA violations ≥ 2 in contract term
  contractTerminationRisk Boolean   @default(false) @map("contract_termination_risk")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  employees   CorporateEmployee[]
  bookings    CorporateBooking[]
  settlements CorporateSettlement[]
  vasPricing  CorporateVASPrice[]
  slas        ContractSLA[]
  amendments  ContractAmendment[]
  inviteLinks CorporateInviteLink[]

  @@index([isActive])
  @@map("corporate_clients")
}

// ─── B2B: Corporate Employees (UC-62/63) ────────────────────────────
// userId is optional until invite is accepted (pending invite for new phone/email).
model CorporateEmployee {
  id              Int       @id @default(autoincrement())
  corporateId     Int       @map("corporate_id")
  userId          Int?      @unique @map("user_id")
  employeeCode    String?   @map("employee_code")
  department      String?
  isAdmin         Boolean   @default(false) @map("is_admin")
  isActive        Boolean   @default(false) @map("is_active") // false until invite accepted
  invitedPhone    String?   @map("invited_phone")
  invitedEmail    String?   @map("invited_email")
  inviteToken     String?   @unique @map("invite_token") @db.VarChar(128)
  inviteExpiresAt DateTime? @map("invite_expires_at")
  inviteUsedAt    DateTime? @map("invite_used_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  corporate CorporateClient    @relation(fields: [corporateId], references: [id], onDelete: Cascade)
  user      User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  bookings  CorporateBooking[]

  @@index([corporateId])
  @@index([inviteToken])
  @@map("corporate_employees")
}

// ─── B2B: Shareable multi-use join link (Slack-style) ────────────────
// Distinct from CorporateEmployee.inviteToken (per-person, single-use). One
// link is shared with many people; each accept creates an ACTIVE employee row
// immediately. maxUses NULL = unlimited; expiresAt NULL = never expires.
model CorporateInviteLink {
  id             Int       @id @default(autoincrement())
  corporateId    Int       @map("corporate_id")
  token          String    @unique @db.VarChar(128)
  defaultIsAdmin Boolean   @default(false) @map("default_is_admin")
  maxUses        Int?      @map("max_uses")
  usedCount      Int       @default(0) @map("used_count")
  expiresAt      DateTime? @map("expires_at")
  isActive       Boolean   @default(true) @map("is_active")
  createdBy      Int?      @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  corporate CorporateClient @relation(fields: [corporateId], references: [id], onDelete: Cascade)

  @@index([corporateId])
  @@index([token])
  @@map("corporate_invite_links")
}

// ─── B2B: Corporate Bookings (UC-64+) ───────────────────────────────
model CorporateBooking {
  id                        Int                    @id @default(autoincrement())
  corporateId               Int                    @map("corporate_id")
  employeeId                Int                    @map("employee_id")
  vehicleId                 Int?                   @map("vehicle_id")
  driverId                  Int?                   @map("driver_id")
  purpose                   String?                @db.Text
  pickupAt                  DateTime               @map("pickup_at")
  returnAt                  DateTime               @map("return_at")
  pickupAddress             String                 @map("pickup_address") @db.Text
  dropoffAddress            String                 @map("dropoff_address") @db.Text
  estimatedKm               Int?                   @map("estimated_km")
  status                    CorporateBookingStatus @default(PENDING)
  basePrice                 Float                  @map("base_price")
  rentalType                String                 @map("rental_type") // half_day | full_day
  vehicleType               String                 @map("vehicle_type") // 4_5_seat | 7_seat | 16_seat
  completedAt               DateTime?              @map("completed_at")
  actualKm                  Int?                   @map("actual_km")
  employeeNote              String?                @map("employee_note") @db.Text
  driverNote                String?                @map("driver_note") @db.Text
  confirmedByEmployee       Boolean                @default(false) @map("confirmed_by_employee")
  confirmedByCorporateAdmin Boolean                @default(false) @map("confirmed_by_corporate_admin")
  confirmedByOtorent        Boolean                @default(false) @map("confirmed_by_otorent")
  settlementId              Int?                   @map("settlement_id")
  finalAmount               Float?                 @map("final_amount")
  // DN chọn lúc xác nhận chuyến: PAY_NOW → tự tạo bảng kê lẻ khi CarGoGo chốt;
  // ON_CREDIT → gom vào kỳ quyết toán tháng. null = chưa chọn (chuyến cũ).
  paymentMode               CorporatePaymentMode?  @map("payment_mode")
  rejectReason              String?                @map("reject_reason") @db.Text
  // ── Marketplace dispatch (supplier fulfillment) ──────────────────
  supplierId                Int?                   @map("supplier_id")
  supplierMemberId          Int?                   @map("supplier_member_id") // tài xế (member) được gán
  dispatchedAt              DateTime?              @map("dispatched_at")
  dispatchedBy              Int?                   @map("dispatched_by") // CarGoGo admin userId
  // Snapshot hoa hồng lúc dispatch — không đổi khi Supplier.commissionRate thay đổi sau
  commissionRate            Float?                 @map("commission_rate")
  commissionAmount          Float?                 @map("commission_amount") // tính khi settle = finalAmount × rate
  supplierVehicleNote       String?                @map("supplier_vehicle_note") @db.Text
  // Driver info handoff (supplier → CarGoGo → DN); DN chỉ thấy sau khi release.
  driverInfoReleasedAt      DateTime?              @map("driver_info_released_at")
  driverInfoReleasedBy      Int?                   @map("driver_info_released_by") // CarGoGo admin userId
  releasedDriverInfo        String?                @map("released_driver_info") @db.Text // JSON: { fullName, phone, vehicleNote?, licensePlate? }
  // Payout chiều CarGoGo → Supplier (mục 7.4) — kỳ payout gom booking đã settle.
  supplierSettlementId      Int?                   @map("supplier_settlement_id")
  createdAt                 DateTime               @default(now()) @map("created_at")
  updatedAt                 DateTime               @updatedAt @map("updated_at")

  corporate          CorporateClient      @relation(fields: [corporateId], references: [id], onDelete: Cascade)
  employee           CorporateEmployee    @relation(fields: [employeeId], references: [id])
  vehicle            Vehicle?             @relation(fields: [vehicleId], references: [id])
  expenses           TripExpense[]
  bookingVAS         BookingVAS[]
  slaViolations      SLAViolation[]
  settlement         CorporateSettlement? @relation(fields: [settlementId], references: [id], onDelete: SetNull)
  supplier           Supplier?            @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplierMember     SupplierMember?      @relation(fields: [supplierMemberId], references: [id], onDelete: SetNull)
  supplierSettlement SupplierSettlement?  @relation(fields: [supplierSettlementId], references: [id], onDelete: SetNull)

  @@index([corporateId, status])
  @@index([employeeId])
  @@index([settlementId])
  @@index([supplierId])
  @@index([supplierSettlementId])
  @@map("corporate_bookings")
}

enum CorporateBookingStatus {
  PENDING
  APPROVED
  DISPATCHED
  DRIVER_ASSIGNED
  IN_PROGRESS
  PENDING_CONFIRM
  CONFIRMED
  SETTLED
  CANCELLED
}

enum CorporatePaymentMode {
  PAY_NOW
  ON_CREDIT
}

// ─── Marketplace: Suppliers (nhà cung xe) ───────────────────────────
model Supplier {
  id                     Int       @id @default(autoincrement())
  name                   String
  taxCode                String?   @unique @map("tax_code")
  address                String?   @db.Text
  contactName            String?   @map("contact_name")
  contactPhone           String?   @map("contact_phone")
  contactEmail           String?   @map("contact_email")
  commissionRate         Float     @default(0.15) @map("commission_rate")
  note                   String?   @db.Text
  // Back-to-back contract obligations (HĐ CCDV Điều 3 — supplier is the real "Bên B")
  contractRef            String?   @map("contract_ref")
  contractStart          DateTime? @map("contract_start")
  contractEnd            DateTime? @map("contract_end")
  transportLicenseNo     String?   @map("transport_license_no")
  criticalViolationCount Int       @default(0) @map("critical_violation_count")
  terminationRisk        Boolean   @default(false) @map("termination_risk")
  isActive               Boolean   @default(true) @map("is_active")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  members     SupplierMember[]
  bookings    CorporateBooking[]
  settlements SupplierSettlement[]
  inviteLinks SupplierInviteLink[]

  @@index([isActive])
  @@map("suppliers")
}

// ─── Marketplace: Supplier members (admin + drivers) ────────────────
model SupplierMember {
  id              Int       @id @default(autoincrement())
  supplierId      Int       @map("supplier_id")
  userId          Int?      @unique @map("user_id")
  fullName        String?   @map("full_name")
  isAdmin         Boolean   @default(false) @map("is_admin")
  isActive        Boolean   @default(false) @map("is_active")
  invitedPhone    String?   @map("invited_phone")
  invitedEmail    String?   @map("invited_email")
  inviteToken     String?   @unique @map("invite_token") @db.VarChar(128)
  inviteExpiresAt DateTime? @map("invite_expires_at")
  inviteUsedAt    DateTime? @map("invite_used_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  supplier Supplier           @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  user     User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  bookings CorporateBooking[]

  @@index([supplierId])
  @@index([inviteToken])
  @@map("supplier_members")
}

// ─── Marketplace: Shareable multi-use join link (Slack-style) ────────
// Distinct from SupplierMember.inviteToken (per-person, single-use). One link
// is shared with many drivers; each accept creates an ACTIVE member row
// immediately. maxUses NULL = unlimited; expiresAt NULL = never expires.
model SupplierInviteLink {
  id             Int       @id @default(autoincrement())
  supplierId     Int       @map("supplier_id")
  token          String    @unique @db.VarChar(128)
  defaultIsAdmin Boolean   @default(false) @map("default_is_admin")
  maxUses        Int?      @map("max_uses")
  usedCount      Int       @default(0) @map("used_count")
  expiresAt      DateTime? @map("expires_at")
  isActive       Boolean   @default(true) @map("is_active")
  createdBy      Int?      @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@index([token])
  @@map("supplier_invite_links")
}

// ─── Marketplace: Supplier payout settlements ─────────────────────────
model SupplierSettlement {
  id                     Int                      @id @default(autoincrement())
  supplierId             Int                      @map("supplier_id")
  periodStart            DateTime                 @map("period_start")
  periodEnd              DateTime                 @map("period_end")
  totalFinalAmount       Float                    @map("total_final_amount")
  totalCommissionAmount  Float                    @map("total_commission_amount")
  supplierPayout         Float                    @map("supplier_payout")
  status                 SupplierSettlementStatus @default(PENDING_DOCUMENTS)
  vatInvoiceRef          String?                  @map("vat_invoice_ref")
  vatInvoiceUrl          String?                  @map("vat_invoice_url") @db.Text
  statementUrl           String?                  @map("statement_url") @db.Text
  dispatchRecordsUrl     String?                  @map("dispatch_records_url") @db.Text
  supportingDocumentsUrl String?                  @map("supporting_documents_url") @db.Text
  rejectionReason        String?                  @map("rejection_reason") @db.Text
  paymentReference       String?                  @map("payment_reference")
  note                   String?                  @db.Text
  submittedAt            DateTime?                @map("submitted_at")
  verifiedAt             DateTime?                @map("verified_at")
  verifiedBy             Int?                     @map("verified_by")
  paidAt                 DateTime?                @map("paid_at")
  paidBy                 Int?                     @map("paid_by")
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")

  supplier Supplier           @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  bookings CorporateBooking[]

  @@index([supplierId, status])
  @@index([periodStart, periodEnd])
  @@map("supplier_settlements")
}

enum SupplierSettlementStatus {
  PENDING_DOCUMENTS
  DOCUMENTS_SUBMITTED
  DOCUMENTS_REJECTED
  VERIFIED
  PAID
}

// ─── Marketplace: Public supplier partner applications (chờ duyệt) ────
// Nhà xe đăng ký công khai → hàng chờ admin duyệt. Khi APPROVED tạo Supplier
// + SupplierMember (SUPPLIER_ADMIN) cho người nộp đơn.
model SupplierApplication {
  id                 Int       @id @default(autoincrement())
  userId             Int       @map("user_id")
  applicantType      String    @default("BUSINESS") @map("applicant_type") // INDIVIDUAL | BUSINESS
  companyName        String    @map("company_name")
  taxCode            String?   @map("tax_code")
  contactName        String?   @map("contact_name")
  contactPhone       String?   @map("contact_phone")
  contactEmail       String?   @map("contact_email")
  address            String    @db.Text
  transportLicenseNo String?   @map("transport_license_no") // Giấy phép KDVT (NĐ 10/2020)
  fleetSize          Int       @default(1) @map("fleet_size")
  vehicleTypes       String?   @map("vehicle_types") @db.Text // "4_5_seat,7_seat,16_seat"
  note               String?   @db.Text
  licenseFileUrl     String?   @map("license_file_url") // Giấy phép / ĐKKD
  status             String    @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewedBy         Int?      @map("reviewed_by")
  reviewNote         String?   @map("review_note") @db.Text
  reviewedAt         DateTime? @map("reviewed_at")
  supplierId         Int?      @map("supplier_id") // set khi duyệt
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("supplier_applications")
}

// ─── B2B: Trip expenses (UC-66+) ────────────────────────────────────
model TripExpense {
  id                 Int             @id @default(autoincrement())
  corporateBookingId Int             @map("corporate_booking_id")
  type               TripExpenseType
  amount             Float
  description        String?         @db.Text
  receiptUrl         String?         @map("receipt_url")
  recordedBy         String          @map("recorded_by") // driver | employee
  recordedAt         DateTime        @default(now()) @map("recorded_at")
  // null = pending review, true = approved, false = rejected
  approvedByAdmin    Boolean?        @map("approved_by_admin")

  booking CorporateBooking @relation(fields: [corporateBookingId], references: [id], onDelete: Cascade)

  @@index([corporateBookingId])
  @@map("trip_expenses")
}

enum TripExpenseType {
  TOLL_ROAD
  PARKING
  OVERTIME
  EXTRA_KM
  ONE_WAY_KM
  OVERNIGHT
  OTHER
}

// ─── B2B: Settlements (UC-69+) ──────────────────────────────────────
model CorporateSettlement {
  id              Int              @id @default(autoincrement())
  corporateId     Int              @map("corporate_id")
  periodStart     DateTime         @map("period_start")
  periodEnd       DateTime         @map("period_end")
  totalBaseAmount Float            @map("total_base_amount")
  totalExpenses   Float            @map("total_expenses")
  totalVat        Float            @map("total_vat")
  totalAmount     Float            @map("total_amount")
  status          SettlementStatus @default(DRAFT)
  invoiceRef      String?          @map("invoice_ref")
  note            String?          @db.Text
  createdAt       DateTime         @default(now()) @map("created_at")
  confirmedAt     DateTime?        @map("confirmed_at")
  paidAt          DateTime?        @map("paid_at")
  paymentMethod   String?          @map("payment_method")
  paymentTxnRef   String?          @unique @map("payment_txn_ref")

  // Manual bank-transfer flow: the corporate admin declares "đã chuyển khoản"
  // (PAYMENT_DECLARED) and optionally uploads a transfer-proof image. Declaring
  // is what alerts OtoRent staff — the proof image is best-effort (may arrive
  // later or not at all if the payer loses connectivity). Admin confirms receipt
  // via mark-paid, so PAID stays the source of truth for "money received".
  paymentDeclaredAt DateTime? @map("payment_declared_at")
  paymentProofUrl   String?   @map("payment_proof_url")

  corporate CorporateClient    @relation(fields: [corporateId], references: [id], onDelete: Cascade)
  bookings  CorporateBooking[]

  @@index([corporateId, status])
  @@map("corporate_settlements")
}

enum SettlementStatus {
  DRAFT
  SENT
  CONFIRMED
  PAYMENT_DECLARED
  PAID
  DISPUTED
}

// ─── ENT: Value-Added Services (UC-76/77) ─────────────────────────
model ValueAddedService {
  id                Int      @id @default(autoincrement())
  code              String   @unique
  name              String
  description       String?  @db.Text
  unit              String
  basePrice         Float    @map("base_price")
  isActive          Boolean  @default(true) @map("is_active")
  requiresHeadcount Boolean  @default(true) @map("requires_headcount")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  clientPricing CorporateVASPrice[]
  bookingVAS    BookingVAS[]

  @@index([isActive])
  @@map("value_added_services")
}

model CorporateVASPrice {
  id          Int     @id @default(autoincrement())
  corporateId Int     @map("corporate_id")
  vasId       Int     @map("vas_id")
  price       Float
  note        String? @db.Text

  corporate CorporateClient   @relation(fields: [corporateId], references: [id], onDelete: Cascade)
  vas       ValueAddedService @relation(fields: [vasId], references: [id], onDelete: Cascade)

  @@unique([corporateId, vasId])
  @@index([corporateId])
  @@map("corporate_vas_prices")
}

model BookingVAS {
  id                 Int       @id @default(autoincrement())
  corporateBookingId Int       @map("corporate_booking_id")
  vasId              Int       @map("vas_id")
  headcount          Int       @default(1)
  unitPrice          Float     @map("unit_price")
  totalPrice         Float     @map("total_price")
  note               String?   @db.Text
  status             VASStatus @default(PENDING)
  providerId         Int?      @map("provider_id")
  confirmedAt        DateTime? @map("confirmed_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  booking CorporateBooking  @relation(fields: [corporateBookingId], references: [id], onDelete: Cascade)
  vas     ValueAddedService @relation(fields: [vasId], references: [id])

  @@index([corporateBookingId])
  @@index([vasId])
  @@map("booking_vas")
}

enum VASStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ─── ENT: Contract SLA (UC-78/79) ─────────────────────────────────
model ContractSLA {
  id          Int     @id @default(autoincrement())
  corporateId Int     @map("corporate_id")
  code        String
  name        String
  description String? @db.Text
  targetValue String? @map("target_value")
  penaltyRule String? @map("penalty_rule") @db.Text
  isActive    Boolean @default(true) @map("is_active")

  corporate  CorporateClient @relation(fields: [corporateId], references: [id], onDelete: Cascade)
  violations SLAViolation[]

  @@unique([corporateId, code])
  @@index([corporateId])
  @@map("contract_slas")
}

model SLAViolation {
  id                 Int               @id @default(autoincrement())
  corporateBookingId Int               @map("corporate_booking_id")
  slaId              Int               @map("sla_id")
  reportedBy         String            @map("reported_by") // employee | corporate_admin | CarGoGo_admin
  reportedById       Int               @map("reported_by_id")
  description        String            @db.Text
  severity           ViolationSeverity @default(MINOR)
  evidenceUrls       String?           @map("evidence_urls") @db.Text // JSON array of URLs
  isConfirmed        Boolean           @default(false) @map("is_confirmed")
  resolution         String?           @db.Text
  resolvedAt         DateTime?         @map("resolved_at")
  createdAt          DateTime          @default(now()) @map("created_at")

  booking CorporateBooking @relation(fields: [corporateBookingId], references: [id], onDelete: Cascade)
  sla     ContractSLA      @relation(fields: [slaId], references: [id], onDelete: Cascade)

  @@index([corporateBookingId])
  @@index([slaId])
  @@map("sla_violations")
}

enum ViolationSeverity {
  MINOR
  MAJOR
  CRITICAL
}

// ─── ENT: Contract amendments (phụ lục HĐ) ────────────────────────
model ContractAmendment {
  id               Int       @id @default(autoincrement())
  corporateId      Int       @map("corporate_id")
  amendmentNo      String    @map("amendment_no")
  title            String
  content          String    @db.Text
  effectiveDate    DateTime  @map("effective_date")
  documentUrl      String?   @map("document_url")
  // JSON partial priceConfig merge applied when both signed + effectiveDate reached
  priceConfigDelta String?   @map("price_config_delta") @db.Text
  signedByA        Boolean   @default(false) @map("signed_by_a")
  signedByB        Boolean   @default(false) @map("signed_by_b")
  appliedAt        DateTime? @map("applied_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  corporate CorporateClient @relation(fields: [corporateId], references: [id], onDelete: Cascade)

  @@unique([corporateId, amendmentNo])
  @@index([corporateId])
  @@map("contract_amendments")
}
