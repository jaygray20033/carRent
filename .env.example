# Server
PORT=4000
NODE_ENV=development

# Database (SQLite for dev, change to postgres/mysql for prod)
DB_DIALECT=sqlite
DB_STORAGE=./database.sqlite

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Booking
BOOKING_DRAFT_TTL_MINUTES=15
BOOKING_PAYMENT_TTL_MINUTES=15
