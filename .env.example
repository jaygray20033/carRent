# Server
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173,http://localhost
FRONTEND_URL=http://localhost:5173

# Database (MySQL via Docker)
DATABASE_URL=mysql://carrent:carrent@localhost:3306/car_rent

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# OTP
OTP_LENGTH=6
OTP_TTL_SECONDS=300

# Booking
BOOKING_DRAFT_TTL_MINUTES=15
BOOKING_PAYMENT_TTL_MINUTES=15

# Payments — VNPay sandbox (register at https://sandbox.vnpayment.vn — Day 17)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:4000/api/v1/payments/vnpay/return
VNPAY_IPN_URL=http://localhost:4000/api/v1/payments/vnpay/ipn

# B2B settlement bank account — OtoRent's receiving account for corporate
# VietQR bank transfers. BANK_BIN is the Napas code (Vietcombank = 970436).
SETTLEMENT_BANK_BIN=970436
SETTLEMENT_BANK_NAME=Vietcombank
SETTLEMENT_BANK_BRANCH=TP.HCM
SETTLEMENT_BANK_ACCOUNT=1042014299
SETTLEMENT_BANK_ACCOUNT_NAME=CONG TY CP QUAN LY VA PHAT TRIEN TAI SAN ASSETHUB

# SePay bank-transfer webhook — shared secret matched against the
# Authorization header. REQUIRED in production (endpoint is public/no-auth).
SEPAY_WEBHOOK_SECRET=

# S3 Storage (optional — falls back to local ./uploads)
# S3_BUCKET=
# S3_REGION=ap-southeast-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=
