{
  "name": "carrent-be",
  "version": "1.0.0",
  "description": "OtoRent Car Rental Backend - Day 13: Confirm Booking + BullMQ Jobs",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "db:migrate": "npx sequelize-cli db:migrate",
    "db:migrate:undo": "npx sequelize-cli db:migrate:undo:all",
    "db:seed": "npx sequelize-cli db:seed:all",
    "db:seed:undo": "npx sequelize-cli db:seed:undo:all",
    "db:reset": "npm run db:migrate:undo && npm run db:migrate && npm run db:seed",
    "worker": "node src/jobs/worker.js",
    "test": "jest --runInBand --forceExit",
    "test:watch": "jest --watch --runInBand"
  },
  "dependencies": {
    "express": "^4.21.0",
    "sequelize": "^6.37.3",
    "sqlite3": "^5.1.7",
    "redis": "^4.7.0",
    "bullmq": "^5.12.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "dayjs": "^1.11.12",
    "uuid": "^10.0.0",
    "http-errors": "^2.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "jest": "^29.7.0",
    "sequelize-cli": "^6.6.2"
  }
}
